@model RegraCategoriaRespostaDTO

@{
    ViewData["Title"] = "Excluir regra";
}

<h1>Excluir regra</h1>

<div class="alert alert-danger">
    Tem certeza de que deseja excluir esta regra?
</div>

<dl class="row">
    <dt class="col-sm-2">Categoria</dt>
    <dd class="col-sm-10">@Model.NomeCategoria</dd>

    <dt class="col-sm-2">Descrição</dt>
    <dd class="col-sm-10">@Model.Descricao</dd>

    <dt class="col-sm-2">Desconto</dt>
    <dd class="col-sm-10">@Model.PercentualDesconto.ToString("N2")%</dd>
</dl>

<form asp-action="Delete" asp-route-identificador="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
