@model CategoriaRespostaDTO

@{
    ViewData["Title"] = "Detalhes da categoria";
    var podeGerenciar = User.IsInRole(PerfisAcesso.Administrador) || User.IsInRole(PerfisAcesso.Gerente);
}

<h1>Detalhes da categoria</h1>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>

    <dt class="col-sm-2">Descrição</dt>
    <dd class="col-sm-10">@Model.Descricao</dd>

    <dt class="col-sm-2">Produtos</dt>
    <dd class="col-sm-10">@Model.QuantidadeProdutos</dd>

    <dt class="col-sm-2">Ativa</dt>
    <dd class="col-sm-10">@(Model.Ativa ? "Sim" : "Não")</dd>

    <dt class="col-sm-2">Criada em</dt>
    <dd class="col-sm-10">@Model.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

@if (podeGerenciar)
{
    <a asp-action="Edit" asp-route-identificador="@Model.Id" class="btn btn-primary">Editar</a>
}
<a asp-action="Index" class="btn btn-secondary">Voltar</a>
