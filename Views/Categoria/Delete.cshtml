@model CategoriaRespostaDTO

@{
    ViewData["Title"] = "Excluir categoria";
}

<h1>Excluir categoria</h1>

<div class="alert alert-danger">
    Tem certeza de que deseja excluir esta categoria? Categorias com produtos ou regras não podem ser removidas.
</div>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>

    <dt class="col-sm-2">Descrição</dt>
    <dd class="col-sm-10">@Model.Descricao</dd>

    <dt class="col-sm-2">Produtos</dt>
    <dd class="col-sm-10">@Model.QuantidadeProdutos</dd>
</dl>

<form asp-action="Delete" asp-route-identificador="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
