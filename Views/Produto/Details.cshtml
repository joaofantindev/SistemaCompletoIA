@model ProdutoRespostaDTO

@{
    ViewData["Title"] = "Detalhes do produto";
    var podeGerenciar = User.IsInRole(PerfisAcesso.Administrador) || User.IsInRole(PerfisAcesso.Proprietario);
}

<h1>Detalhes do produto</h1>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>

    <dt class="col-sm-2">Marca</dt>
    <dd class="col-sm-10">@Model.Marca</dd>

    <dt class="col-sm-2">Categoria</dt>
    <dd class="col-sm-10">@Model.NomeCategoria</dd>

    <dt class="col-sm-2">Preço</dt>
    <dd class="col-sm-10">R$ @Model.Preco.ToString("N2")</dd>

    <dt class="col-sm-2">Proprietário</dt>
    <dd class="col-sm-10">@Model.NomeProprietario</dd>

    <dt class="col-sm-2">Cadastrado em</dt>
    <dd class="col-sm-10">@Model.CadastradoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

@if (podeGerenciar)
{
    <a asp-action="Edit" asp-route-identificador="@Model.Id" class="btn btn-primary">Editar</a>
}
<a asp-action="Index" class="btn btn-secondary">Voltar</a>
