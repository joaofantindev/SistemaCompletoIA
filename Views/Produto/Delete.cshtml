@model ProdutoRespostaDTO

@{
    ViewData["Title"] = "Excluir produto";
}

<h1>Excluir produto</h1>

<div class="alert alert-danger">
    Tem certeza de que deseja excluir este produto?
</div>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>

    <dt class="col-sm-2">Marca</dt>
    <dd class="col-sm-10">@Model.Marca</dd>

    <dt class="col-sm-2">Categoria</dt>
    <dd class="col-sm-10">@Model.NomeCategoria</dd>

    <dt class="col-sm-2">Preço</dt>
    <dd class="col-sm-10">R$ @Model.Preco.ToString("N2")</dd>
</dl>

<form asp-action="Delete" asp-route-identificador="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
